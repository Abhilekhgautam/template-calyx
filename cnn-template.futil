import "primitives/core.futil";

component lineBuffer(pixel_in_c0: 32, @go go: 1) -> (
    win_0_0: 32, win_0_1: 32, win_0_2: 32, win_0_3: 32, win_0_4: 32,
    win_1_0: 32, win_1_1: 32, win_1_2: 32, win_1_3: 32, win_1_4: 32,
    win_2_0: 32, win_2_1: 32, win_2_2: 32, win_2_3: 32, win_2_4: 32,
    win_3_0: 32, win_3_1: 32, win_3_2: 32, win_3_3: 32, win_3_4: 32,
    win_4_0: 32, win_4_1: 32, win_4_2: 32, win_4_3: 32, win_4_4: 32,
    @done done: 1) {
  
  cells {

    //Store pixels for 4 windows
    @external mem_0 = seq_mem_d1(32, 60, 1)
    @external mem_1 = seq_mem_d1(32, 60, 1)
    @external mem_2 = seq_mem_d1(32, 60, 1)
    @external mem_3 = seq_mem_d1(32, 60, 1)
 
    // Pixels for Sliding window

    reg_0_0 = std_reg(32)
    reg_0_1 = std_reg(32)
    reg_0_2 = std_reg(32)
    reg_0_3 = std_reg(32)
    reg_0_4 = std_reg(32)
    reg_1_0 = std_reg(32)
    reg_1_1 = std_reg(32)
    reg_1_2 = std_reg(32)
    reg_1_3 = std_reg(32)
    reg_1_4 = std_reg(32)
    reg_2_0 = std_reg(32)
    reg_2_1 = std_reg(32)
    reg_2_2 = std_reg(32)
    reg_2_3 = std_reg(32)
    reg_2_3 = std_reg(32)
    reg_3_0 = std_reg(32)
    reg_3_1 = std_reg(32)
    reg_3_2 = std_reg(32)
    reg_3_3 = std_reg(32)
    reg_3_4 = std_reg(32)
    reg_4_0 = std_reg(32)
    reg_4_1 = std_reg(32)
    reg_4_2 = std_reg(32)
    reg_4_3 = std_reg(32)
    reg_4_4 = std_reg(32)

  }

  wires {

  }
}

component main(@go go: 1) -> (@done done: 1) {
  cells {}
  wires {}
  control {}
}

